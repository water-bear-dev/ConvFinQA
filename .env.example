# Ollama (local, preferred when set)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional: larger local model if VRAM allows
# OLLAMA_MODEL=qwen2.5:14b-instruct

# Gemini (hosted fallback when Ollama is not configured)
# GOOGLE_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Solver routing: auto | single | two_step
SOLVER_ROUTER=auto
